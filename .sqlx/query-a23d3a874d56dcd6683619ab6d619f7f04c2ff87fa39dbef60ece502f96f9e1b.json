  "query": "\n        select id, code, education_level, study_year\n        from student_groups\n        where not exists (\n            select 1\n            from teaching_course_groups taken\n            where taken.subject_id = $1\n              and taken.student_group_id = student_groups.id\n        )\n        order by code, id\n        limit $2 offset $3\n        ",
