  "query": "\n        select\n            id,\n            subject_id,\n            created_at,\n            array(\n                select student_group_id\n                from teaching_course_groups\n                where teaching_course_id = teaching_courses.id\n            ) as \"group_ids!: Vec<Uuid>\",\n            array(\n                select teacher_id\n                from teaching_course_teachers\n                where teaching_course_id = teaching_courses.id\n            ) as \"teacher_ids!: Vec<Uuid>\"\n        from teaching_courses\n        where id = $1\n        ",
